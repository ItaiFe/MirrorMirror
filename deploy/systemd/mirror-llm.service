# The oracle's brain: llama.cpp server (Gemma 3 4B Q4_K_M, all layers on the GPU) on 127.0.0.1:8080.
# A systemd *user* unit; deploy/setup_orin.sh installs it into ~/.config/systemd/user/.
[Unit]
Description=Mirror, Mirror: llama-server (Gemma 3 4B)
StartLimitIntervalSec=0

[Service]
# The model file in ~/mirror-models; to try another (e.g. the Gemma 4 E2B runner-up):
# systemctl --user edit mirror-llm  ->  [Service] Environment=LLM_MODEL=<file>.gguf
Environment=LLM_MODEL=gemma-3-4b-it-Q4_K_M.gguf
# --swa-full: Gemma 3's sliding-window cache otherwise turns cache_reuse off, and the
# English slot re-processes ~500 prompt tokens per turn (+~580 MiB KV)
ExecStart=%h/mirror-bin/llama-server -m %h/mirror-models/${LLM_MODEL} -ngl 99 -c 8192 -np 2 --cache-reuse 256 --swa-full --host 127.0.0.1 --port 8080
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
