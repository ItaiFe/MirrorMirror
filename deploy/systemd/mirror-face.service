# The face renderer: full-screen pygame window on the X display that feeds the LED panels.
# A systemd *user* unit; deploy/setup_orin.sh installs it into ~/.config/systemd/user/,
# replacing @REPO@ with the repo checkout. It needs the GDM autologin session's X server
# (Xorg, not Wayland). Until that is up, xset fails and systemd retries every 2 s.
[Unit]
Description=Mirror, Mirror: face renderer
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
Environment=DISPLAY=:0
Environment=XAUTHORITY=%t/gdm/Xauthority
WorkingDirectory=@REPO@
# No screen saver, no blanking, no DPMS power-off.
ExecStartPre=/usr/bin/xset s off -dpms
# Lock the connected output (the MSD300) to 1920x1080 if it isn't already. Best
# effort ("-"): if the card doesn't offer that mode, the face still starts and pygame
# asks for it. mirror-dpms.timer re-applies the xset line every 10 min.
ExecStartPre=-/bin/sh -c 'line=$$(xrandr | grep -m1 " connected") && out=$$(echo "$$line" | cut -d" " -f1) && [ -n "$$out" ] && { echo "$$line" | grep -q " 1920x1080+" || xrandr --output "$$out" --mode 1920x1080; }'
ExecStart=@REPO@/.venv/bin/mirror-face --config @REPO@/config/orin.toml
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
